
#include <iostream>
#include <string>
#include <limits>
using namespace std;

// Node structure for Singly Linked List
struct Ticket {
    int ticketId;
    string passengerName;
    int age;
    string trainNo;
    string source;
    string destination;
    Ticket* next;
};

Ticket* head = NULL;
int ticketCounter = 1001;

// Display available trains
void preDefineTrainList() {
    cout << "\n--- Available Trains ---\n";
    cout << "101 - Deccan Express\n";
    cout << "102 - Rajdhani Express\n";
    cout << "103 - Shatabdi Express\n";
    cout << "------------------------\n";
}

// Book a new ticket
void bookTicket() {
    Ticket* newNode = new Ticket;

    newNode->ticketId = ticketCounter++;

    cout << "\n--- Enter Passenger Details ---\n";

    cout << "Enter Name: ";
    getline(cin >> ws, newNode->passengerName);

    cout << "Enter Age: ";
    cin >> newNode->age;

    if (cin.fail() || newNode->age <= 0) {
        cout << "Invalid age! Booking cancelled.\n";
        delete newNode;
        cin.clear();
        cin.ignore(numeric_limits<streamsize>::max(), '\n');
        ticketCounter--;
        return;
    }

    preDefineTrainList();
    cout << "Enter Train No: ";
    cin >> newNode->trainNo;

    if (newNode->trainNo != "101" &&
        newNode->trainNo != "102" &&
        newNode->trainNo != "103") {
        cout << "Invalid train number! Booking cancelled.\n";
        delete newNode;
        ticketCounter--;
        return;
    }

    cout << "Enter Source: ";
    getline(cin >> ws, newNode->source);

    cout << "Enter Destination: ";
    getline(cin >> ws, newNode->destination);

    newNode->next = NULL;

    // Insert the new node at the end
    if (head == NULL) {
        head = newNode;
    } else {
        Ticket* temp = head;

        while (temp->next != NULL) {
            temp = temp->next;
        }

        temp->next = newNode;
    }

    cout << "\nTicket booked successfully!\n";
    cout << "PNR / Ticket ID: " << newNode->ticketId << endl;
}

// Display all booked tickets
void showTickets() {
    if (head == NULL) {
        cout << "\nNo tickets booked yet!\n";
        return;
    }

    Ticket* temp = head;

    cout << "\n--- All Booked Tickets ---\n";

    while (temp != NULL) {
        cout << "\nPNR: " << temp->ticketId;
        cout << "\nName: " << temp->passengerName;
        cout << "\nAge: " << temp->age;
        cout << "\nTrain No: " << temp->trainNo;
        cout << "\nRoute: " << temp->source
             << " -> " << temp->destination << endl;

        temp = temp->next;
    }
}

// Cancel a ticket using PNR
void cancelTicket() {
    if (head == NULL) {
        cout << "\nNo tickets available to cancel!\n";
        return;
    }

    int id;
    cout << "\nEnter PNR / Ticket ID to cancel: ";
    cin >> id;

    Ticket* temp = head;
    Ticket* prev = NULL;

    // Search for the ticket
    while (temp != NULL && temp->ticketId != id) {
        prev = temp;
        temp = temp->next;
    }

    if (temp == NULL) {
        cout << "\nTicket not found!\n";
        return;
    }

    // Delete the first node
    if (prev == NULL) {
        head = temp->next;
    } else {
        prev->next = temp->next;
    }

    delete temp;

    cout << "\nTicket cancelled successfully!\n";
    cout << "PNR: " << id << endl;
}

// Free all dynamically allocated nodes
void freeAllNodes() {
    while (head != NULL) {
        Ticket* temp = head;
        head = head->next;
        delete temp;
    }

    cout << "\nAll ticket records cleared.\n";
}

int main() {
    int choice;

    do {
        cout << "\n===== RAILWAY TICKET BOOKING SYSTEM =====\n";
        cout << "1. Book Ticket\n";
        cout << "2. Show All Tickets\n";
        cout << "3. Cancel Ticket\n";
        cout << "4. Exit\n";
        cout << "Enter Your Choice: ";
        cin >> choice;

        switch (choice) {
            case 1:
                bookTicket();
                break;

            case 2:
                showTickets();
                break;

            case 3:
                cancelTicket();
                break;

            case 4:
                freeAllNodes();
                cout << "Thank you for using the system!\n";
                break;

            default:
                cout << "Invalid choice! Please try again.\n";
        }

    } while (choice != 4);

    return 0;
}
